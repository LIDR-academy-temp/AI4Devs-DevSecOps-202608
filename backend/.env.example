# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Base de datos de desarrollo (servicio `db` de compose.yaml).
# La de pruebas va en .env.test, puerto 54411.
#--------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=54410
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync

#--------------------------------------------------------------------
# Rol de solo lectura flowsync_ro (make db-readonly), para que un agente
# mire la base de desarrollo. Ponle una contraseña propia en tu .env.
#--------------------------------------------------------------------
DB_RO_PASSWORD=flowsync-ro-ejemplo

#--------------------------------------------------------------------
# Identidad de la app para OpenTelemetry
#--------------------------------------------------------------------
APP_NAME=flowsync-api
APP_VERSION=0.0.1
APP_ENV=development

#--------------------------------------------------------------------
# Trazas: cambiar de destino es cambiar esta dirección (puerto HTTP 4318, no el gRPC 4317).
# Si el destino pide credenciales, añade OTEL_EXPORTER_OTLP_HEADERS.
#--------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318